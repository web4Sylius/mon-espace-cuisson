// 				email($client[0], $subject, stripslashes($htmlmess), $email_marchand);
				$facture=new facture($DB_site,$_POST[RefID]);
				$template=new template($facture->utilisateur->langue,$DB_site);
				$template->path="../../templates/".$facture->utilisateur->langue;
				mailconfirmation(8,$facture,null);
				$diss=new dissociation($DB_site,$_POST[RefID]);
			}
			break;
		case '101': //KO Annulation de la transaction
			$DB_site->query("UPDATE facture SET valide = '3' WHERE facturid = '".$_POST[RefID]."'");
