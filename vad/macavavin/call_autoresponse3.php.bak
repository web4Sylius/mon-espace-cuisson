		case '2': //Ko Commande refusée
			$DB_site->query("UPDATE facture SET valide = '3' WHERE facturid = '".$_POST[RefID]."'");
			break;
		case '3': //U Commande sous surveillance FIA-NET
			$DB_site->query("UPDATE facture SET valide = '0' WHERE facturid = '".$_POST[RefID]."'");
			break;
		case '10': //Surveillance OK, la commande est libérée
			$etatactuelbase=$DB_site->query_first("select valide from facture WHERE facturid = '".$_POST[RefID]."'");
			if ($etatactuelbase[valide] != 5) {
				$DB_site->query("UPDATE facture SET valide = '1' WHERE facturid = '".$_POST[RefID]."'");
				$mail_contact=$DB_site->query_first("SELECT mail_contact FROM parametresgeneraux");
				$client=$DB_site->query_first("select * from facture WHERE facturid = '".$_POST[RefID]."'");
				$htmlmess = "Bonjour,<br>";
				$htmlmess .= "Vous avez reçu une nouvelle <b>commande par Receive and Pay</b><br>Numero de facture : $client[facturid]<br>";
				$htmlmess .= "Connectez vous a votre espace d'administration arobases pour plus d informations.<br>";
				$htmlmess .= "Cette transaction est déjà notée <font color=blue>Validée</font> Libre à vous de l expedier ou de la refuser.<br>";
				$htmlmess .= "Si vous la refusez, n oubliez pas de vous connecter à l espace d'administration de votre banque et de rembourser votre client.";
				$subject="Reception d'une commande par Receive and Pay";
// 				email($email_marchand, $subject, stripslashes($htmlmess), $email_marchand);
				
				$message="ma-cave-a-vin.fr : Validation de la transaction $transaction_id\n";
				$htmlmess = "Bonjour,<br>";
				$htmlmess .= "Votre <b>commande par Receive and Pay</b> sur ma-cave-a-vin.fr a été validée par votre établissement bancaire.<br>
				Vous recevrez un e-mail dès qu'elle sera expédiée.
				<br>Cordialement,<br><br>
				L'équipe ma-cave-a-vin.fr.";
				$subject="Commande par Receive and Pay validée sur ma-cave-a-vin.fr";
// 				email($client[0], $subject, stripslashes($htmlmess), $email_marchand);
				$facture=new facture($DB_site,$_POST[RefID]);
				$template=new template($facture->utilisateur->langue,$DB_site);
				$template->path="../../templates/".$facture->utilisateur->langue;
				mailconfirmation(8,$facture,null);
				$diss=new dissociation($DB_site,$_POST[RefID]);
			}
			break;
		case '11': //Surveillance KO, la commande est annulée
			$DB_site->query("UPDATE facture SET valide = '3' WHERE facturid = '".$_POST[RefID]."'");
			break;
		case '100': //OK Cloture de la transaction
			$etatactuelbase=$DB_site->query_first("select valide from facture WHERE facturid = '".$_POST[RefID]."'");
			if ($etatactuelbase[valide] != 5) {
				$DB_site->query("UPDATE facture SET valide = '1' WHERE facturid = '".$_POST[RefID]."'");
				$mail_contact=$DB_site->query_first("SELECT mail_contact FROM parametresgeneraux");
				$client=$DB_site->query_first("select * from facture WHERE facturid = '".$_POST[RefID]."'");
				$htmlmess = "Bonjour,<br>";
				$htmlmess .= "Vous avez reçu une nouvelle <b>commande par Receive and Pay</b><br>Numero de facture : $client[facturid]<br>";
				$htmlmess .= "Connectez vous a votre espace d'administration arobases pour plus d informations.<br>";
				$htmlmess .= "Cette transaction est déjà notée <font color=blue>Validée</font> Libre à vous de l expedier ou de la refuser.<br>";
