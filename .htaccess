RewriteRule ^trf,([0-9]+),([0-9,a-z,A-Z,-]+),([0-9]+),([libelleFR|libelleDE|libelleEN|libelleIT|libelleSP|prix]+),([DESC|ASC]+),([0-9,=,&]+)\.html?$ categorie.php?catid=$1&order=$4&sensorder=$5&filtresup=$6&pagenumber=$3 [QSA,L]
