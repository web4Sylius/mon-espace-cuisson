#RewriteCond %{REQUEST_URI} !\.(jpe?g?|png|gif) [NC]
#RewriteCond %{REMOTE_ADDR} !^80.12.82.212$
#RewriteCond %{REMOTE_ADDR} !^2a01:e0a:559:eac0:b1a5:6dc5:2e7d:fea5$
